#!/usr/bin/env bash
# press: compile markdown to PDF via pandoc + typst
set -euo pipefail

STYLE_DIR="${PRESS_STYLE_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/press}"
style=sans

usage() { echo "usage: press [-s style] file.md..." >&2; }

while getopts "s:h" opt; do
  case $opt in
    s) style=$OPTARG ;;
    h) usage; exit 0 ;;
    *) usage; exit 2 ;;
  esac
done
shift $((OPTIND - 1))
[[ $# -gt 0 ]] || { usage; exit 2; }

tpl="$STYLE_DIR/$style.typ"
[[ -f $tpl ]] || { echo "press: no style '$style' in $STYLE_DIR" >&2; exit 1; }

for f in "$@"; do
  [[ -f $f ]] || { echo "press: $f: not found" >&2; continue; }
  out="${f%.*}.pdf"
  pandoc "$f" -o "$out" \
    --from=gfm+yaml_metadata_block+tex_math_dollars \
    --pdf-engine=typst --template="$tpl" --lua-filter="$STYLE_DIR/press.lua" \
    --resource-path="$(dirname "$f")" \
    -V styledir="$STYLE_DIR" \
    --pdf-engine-opt=--root=/
  echo "$f → $out"
done
